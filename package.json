{
  "name": "murmel",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Meditatives Murmelspiel: Glasmurmeln rollen an ihren Platz, bis ein Bild entsteht.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/artifact.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ios": "npm run build && cap sync ios",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build:preview": "vite build --mode test-preview && node scripts/artifact.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@capacitor/cli": "^8.6.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
